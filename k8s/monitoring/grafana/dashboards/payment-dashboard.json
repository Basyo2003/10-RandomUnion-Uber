{
  "annotations": {"list": []},
  "description": "Payment Service dashboard — LogQL + PromQL panels (S5-READ-DB / S5-INFRA).",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "${ds_loki}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "title": "Error Rate (LogQL)",
      "description": "Count of ERROR-level log lines from payment-service per minute.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "sum(count_over_time({app=\"uber\", service=\"payment-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "Errors/min",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "loki", "uid": "${ds_loki}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "title": "Payment Event Audit (LogQL)",
      "description": "Log lines from payment-service event publishers and consumers, filtered by routing key.",
      "type": "logs",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "{app=\"uber\", service=\"payment-service\"} | json | routingKey != \"\"",
          "legendFormat": "Events",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "loki", "uid": "${ds_loki}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "title": "Payment State Transitions (LogQL)",
      "description": "COMPLETED vs REFUNDED vs FAILED payment events per minute.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "sum(count_over_time({app=\"uber\", service=\"payment-service\"} |= \"COMPLETED\" [1m]))",
          "legendFormat": "COMPLETED/min",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "sum(count_over_time({app=\"uber\", service=\"payment-service\"} |= \"REFUNDED\" [1m]))",
          "legendFormat": "REFUNDED/min",
          "refId": "B"
        },
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "sum(count_over_time({app=\"uber\", service=\"payment-service\"} |= \"FAILED\" [1m]))",
          "legendFormat": "FAILED/min",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "options": {
        "legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "title": "HTTP Request Rate (PromQL)",
      "description": "Requests/sec per endpoint and method for payment-service.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
          "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{job=\"payment-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}, "unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "title": "HTTP Latency P99 (PromQL)",
      "description": "99th-percentile latency per endpoint for payment-service.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
          "expr": "histogram_quantile(0.99, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"payment-service\"}[5m])))",
          "legendFormat": "p99 {{uri}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
          "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"payment-service\"}[5m])))",
          "legendFormat": "p95 {{uri}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1}, "unit": "bytes"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "title": "JVM Heap Usage (PromQL)",
      "description": "Used vs committed heap for payment-service.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
          "expr": "jvm_memory_used_bytes{job=\"payment-service\", area=\"heap\"}",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
          "expr": "jvm_memory_committed_bytes{job=\"payment-service\", area=\"heap\"}",
          "legendFormat": "heap committed",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["uber", "payment-service", "m3", "s5-read-db", "s5-infra"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "name": "ds_prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "name": "ds_loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Payment Service",
  "uid": "uber-payment-service",
  "version": 1
}
